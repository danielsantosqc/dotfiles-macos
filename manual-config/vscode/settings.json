{
  // ============================================
  // VENTANA - Apariencia general
  // ============================================
  "window.density.editorTabHeight": "compact",
  "window.title": "${rootName}${separator}${profileName}",
  "window.titleSeparator": " — ",
  "window.autoDetectHighContrast": false,
  "window.customTitleBarVisibility": "auto",

  // ============================================
  // TEMA - Iconos y colores
  // ============================================
  "workbench.iconTheme": "vscode-icons",
  "workbench.startupEditor": "none",
  "workbench.editor.dragToOpenWindow": true,
  "vsicons.dontShowNewVersionMessage": true,

  // ============================================
  // TEMA - Colores personalizados de sintaxis
  // ============================================
  "editor.tokenColorCustomizations": {
    "[*Light*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#b15a5a"
          }
        }
      ]
    },
    "[*Dark*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#fff"
          }
        }
      ]
    },
    "textMateRules": [
      {
        "scope": "keyword.operator",
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  "workbench.colorCustomizations": {
    "[SynthWave '84]": {
      // Personalizaciones comentadas
    },
    "[SynthWave 84' Remix Min Darker (by FernaandoJr)]": {
      // Personalizaciones comentadas
    },
    "[Ayu Dark Bordered]": {
      "commandCenter.background": "#000000",
      "tab.activeBackground": "#000000",
      "tab.activeBorder": "#000000",
      "editor.background": "#000000"
    }
  },

  // ============================================
  // EDITOR - Comportamiento general
  // ============================================
  "editor.fontSize": 14,
  "editor.fontFamily": "'Menlo', 'DejaVu Sans Mono', 'Lucida Console', monospace",
  "editor.fontLigatures": true,
  "editor.tabSize": 2,
  "editor.minimap.autohide": "mouseover",
  "editor.minimap.maxColumn": 90,
  "editor.guides.bracketPairs": "active",
  "editor.guides.highlightActiveBracketPair": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.glyphMargin": false,
  "editor.lineDecorationsWidth": 0,
  "editor.linkedEditing": true,
  "editor.mouseWheelZoom": true,
  "editor.inlineSuggest.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.wordWrap": "on",
  "editor.wordWrapColumn": 115,
  "editor.accessibilitySupport": "off",
  "editor.acceptSuggestionOnEnter": "on",
  "editor.tabCompletion": "off",

  // ============================================
  // ARCHIVOS - Asociaciones y explorador
  // ============================================
  "files.associations": {
    ".env*": "dotenv",
    "**/ui/src/platform/mac/**/*.h": "objective-c"
  },
  "explorer.compactFolders": false,

  // ============================================
  // TERMINAL
  // ============================================
  "terminal.integrated.fontFamily": "AdwaitaMono Nerd Font",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorStyleInactive": "none",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.stickyScroll.enabled": true,
  "terminal.integrated.enableMultiLinePasteWarning": "auto",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.env.osx": {
    "Q_NEW_SESSION": "1"
  },
  "terminal.integrated.env.linux": {},
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.accessibleViewFocusOnCommandExecution": true,
  "terminal.integrated.accessibleViewPreserveCursorPosition": true,
  "terminal.explorerKind": "external",

  // ============================================
  // GIT
  // ============================================
  "git.confirmSync": false,

  // ============================================
  // ERROR LENS - Visualizador de errores
  // ============================================
  "errorLens.onSave": true,
  "errorLens.gutterIconsEnabled": true,
  "errorLens.gutterIconSet": "emoji",

  // ============================================
  // PRETTIER - Formateador con estilo Standard
  // ============================================
  "prettier.semi": false,
  "prettier.singleQuote": true,
  "prettier.tabWidth": 2,
  "prettier.trailingComma": "none",
  "prettier.arrowParens": "avoid",
  "prettier.jsxSingleQuote": true,
  "prettier.bracketSpacing": true,

  // ============================================
  // ESLINT - DESACTIVADO (comentado)
  // ============================================
  // "eslint.alwaysShowStatus": true,
  // "eslint.problems.shortenToSingleLine": true,
  // "eslint.run": "onSave",
  // "eslint.format.enable": true,
  // "eslint.quiet": false,
  // "eslint.debug": false,
  // "eslint.probe": [
  //   "javascript",
  //   "javascriptreact",
  //   "typescript",
  //   "typescriptreact",
  //   "html",
  //   "vue",
  //   "markdown"
  // ],

  // ============================================
  // STANDARD - Linter + Fixer
  // ============================================
  "standard.enable": true,
  "standard.enableGlobally": true,
  "standard.autoFixOnSave": false,
  "standard._legacyModuleResolve": true,
  "standard.run": "onSave",
  "standard.validate": [
    "javascript",
    "javascriptreact"
  ],
  "standard.engine": "standard",
  "standard.usePackageJson": false,
  "standard.options": {
    "ignore": [
      "node_modules/**"
    ]
  },

  // ============================================
  // ACCIONES AL GUARDAR
  // ============================================
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.standard": "explicit"
  },

  // ============================================
  // FORMATEADORES POR LENGUAJE
  // ============================================
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.autopep8",
    "editor.formatOnSave": true
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": false
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
    "editor.formatOnSave": true
  },
  "[snippets]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },

  // ============================================
  // PYTHON
  // ============================================
  "python.languageServer": "Pylance",

  // ============================================
  // GITHUB COPILOT
  // ============================================
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "javascript": false
  },
  "github.copilot.nextEditSuggestions.enabled": false,

  // ============================================
  // GOOGLE GEMINI CODE ASSIST
  // ============================================
  "geminicodeassist.inlineSuggestions.enableAuto": false,
  "geminicodeassist.displayInlineContextHint": false,
  "geminicodeassist.project": "elated-smoke-7vrh3",

  // ============================================
  // DOTENV
  // ============================================
  "dotenv.cloakIcon": "🔐",
  "dotenv.enableAutocloaking": false,
  "dotenv.enableSecretpeeking": true,

  // ============================================
  // LIVE SERVER
  // ============================================
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.CustomBrowser": "chrome:PrivateMode",

  // ============================================
  // CSpell - Corrector ortográfico
  // ============================================
  "cSpell.language": "en,es,pt,pt-BR",
  "cSpell.userWords": [
    "airbnb",
    "alphanum",
    "autohide",
    "autopep",
    "bolivia",
    "bson",
    "burguer",
    "Bwus",
    "Cancion",
    "colombia",
    "colours",
    "contrasena",
    "crazymax",
    "cualq",
    "daniel",
    "danielsan",
    "danielsantosqc",
    "datasheet",
    "dbname",
    "dockermon",
    "dont",
    "encadenables",
    "esbenp",
    "fashionstore",
    "fastapi",
    "february",
    "gatito",
    "gatitos",
    "github",
    "hasheada",
    "HEALTHCHECK",
    "indentar",
    "inicialización",
    "january",
    "jsonify",
    "linebreak",
    "linkedin",
    "localip",
    "Loguea",
    "matplotlib",
    "maximo",
    "mayúsc",
    "middlewares",
    "minúsc",
    "mismodulos",
    "mongodb",
    "mongodump",
    "mongoexport",
    "mongoimport",
    "mongorestore",
    "mongosh",
    "mysql",
    "mysqldump",
    "myversion",
    "nginx",
    "notificacion",
    "numeros",
    "opcion",
    "peliculas",
    "pgcrypto",
    "platzi",
    "plpgsql",
    "pokemon",
    "porcoes",
    "postgres",
    "postgresql",
    "produccion",
    "psql",
    "PSQL",
    "pyenv",
    "pyplot",
    "reintentando",
    "rror",
    "savefig",
    "SGBD",
    "spotify",
    "subconsulta",
    "tecnicos",
    "tlds",
    "uuidv",
    "venv",
    "virtualenv",
    "vsicons",
    "whatsapp",
    "WHATSAPP",
    "Zuckerberg"
  ],
  "cSpell.enabledFileTypes": {
    "*": true,
    "markdown": true
  },
  "cSpell.ignorePaths": [
    "node_modules",
    "**/node_modules",
    "**/node_modules/**",
    "node_modules/**",
    "vscode-extension",
    ".git",
    "*.dll",
    "**/*.dll"
  ],
  "cSpell.customDictionaries": {
    "custom-dictionary-user": {
      "name": "custom-dictionary-user",
      "path": "~/.cspell/custom-dictionary-user.txt",
      "addWords": true,
      "scope": "user"
    }
  },

  // ============================================
  // EXTENSIONES - Configuraciones varias
  // ============================================
  "hediet.vscode-drawio.resizeImages": null,
  "auto-rename-tag.activationOnLanguage": [
    "*"
  ],
  "security.workspace.trust.untrustedFiles": "open",
  "security.promptForLocalFileProtocolHandling": false,
  "diffEditor.codeLens": true,
  "editor.wrapOnEscapedLineFeeds": true,
  "workbench.colorTheme": "Ayu Dark Bordered",
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  }
}